# ==================== TEMU 电商智能作图系统 本地个人版示例配置 ====================
# 复制此文件为 .env，再按需填写。

# ==================== 基础配置 ====================
APP_PORT=8501

# ==================== 启动器 / 更新配置 ====================
# 可选：默认会自动尝试识别外层 git 仓库。
# 如果需要手动指定，可取消注释：
# APP_UPDATE_REPO_ROOT=/absolute/path/to/repo
# APP_UPDATE_REMOTE=origin
# APP_UPDATE_BRANCH=main

# ==================== Gemini 直连引导 ====================
# 只要下面任意一个 Key 有值，且本地 providers.json 还是空的，
# 应用会在首次启动时自动创建一个默认 Gemini 提供商。
# 获取地址: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_API_KEY=

# relay 或自定义 Base URL 不通过环境变量注入。
# 如需使用中转，请启动应用后到“提供商设置”页面添加 relay 提供商，
# 再填写 Base URL、API Key，以及可选的标题模型、视觉模型、图像模型。

# ==================== 文件存储配置 ====================
# 默认使用本地存储。
# 可选值: local, s3
FILE_STORAGE_TYPE=local

# 文件保留天数。
# 0 表示不自动清理。
FILE_RETENTION_DAYS=7

# 本地文件目录。
FILE_STORAGE_PATH=/app/data/files

# ==================== S3 / 对象存储，可选 ====================
# 仅在 FILE_STORAGE_TYPE=s3 时需要填写。
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=temu-files/
S3_PRESIGN_EXPIRES=86400

# ==================== 使用提示 ====================
# 1. 本地个人版默认直接进入应用，不需要管理员初始化。
# 2. 不想在 .env 中放 Key，也可以启动后去“提供商设置”手动添加。
# 3. 如果保留本地默认存储，可不填写任何 S3 字段。
